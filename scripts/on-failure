#!/bin/sh
# Noon on_failure hook for every job: notify once when a job starts failing, e.g. an expired
# Slack token or a failed update.
# Noon's NOON_PREVIOUS_STATUS ignores noops, so later failures in a streak stay quiet.
case "${NOON_PREVIOUS_STATUS-}" in failed | timed_out) exit 0 ;; esac

# Never read hook stdin or NOON_LOG_FILE: logs may quote message text.
exec "$(dirname "$0")/notify" "watch: ${NOON_JOB:-job} failing" "Status: ${NOON_STATUS-unknown}
Run: noon logs ${NOON_RUN_ID-}" --type failure

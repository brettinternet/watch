#!/bin/sh
# Noon update job: fast-forward the primary checkout so scheduled triage runs the latest code.
# Exits 78 (a Noon noop) when already current.
set -eu
before=$(git rev-parse HEAD)
git fetch --quiet
git merge --ff-only --quiet "@{upstream}"
[ "$(git rev-parse HEAD)" != "$before" ] || exit 78
mise exec bun -- bun install --frozen-lockfile
# Noon pauses changed jobs until they are approved again.
git diff --quiet "$before" HEAD -- noon.yaml ||
  "$(dirname "$0")/notify" "watch: jobs changed" "noon.yaml changed in an update; run noon enable in $(pwd)" --type warning

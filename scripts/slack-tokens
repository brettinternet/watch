#!/usr/bin/env python3
"""Extract Slack stealth-mode tokens from the macOS desktop app into .env.local.

Devtool convenience, best-effort: it reads this machine's logged-in Slack session the way
the slack-mcp-server docs describe doing by hand. The xoxd cookie is decrypted with the
"Slack Safe Storage" Keychain key (you may get a one-time Keychain prompt). Local Storage
keeps xoxc tokens from signed-out sessions until compaction, so each candidate is checked
with auth.test against that cookie and only live sessions are kept. Re-run it when a token
expires.

    scripts/slack-tokens acme                  # the signed-in workspace whose team name/url contains "acme"
    scripts/slack-tokens work --workspace acme # when the source name doesn't match it

Writes SLACK_<NAME>_XOXC_TOKEN and SLACK_<NAME>_XOXD_TOKEN to .env.local, plus the desktop
app's SLACK_<NAME>_USER_AGENT and SLACK_<NAME>_CUSTOM_TLS so slack-mcp-server looks like the
app; Enterprise Grid revokes the session when it sees a different client.
"""

from __future__ import annotations

import argparse
import glob
import hashlib
import json
import os
import platform
import plistlib
import re
import sqlite3
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

APP_DIR = os.path.expanduser("~/Library/Application Support/Slack")
APP_BUNDLE = "/Applications/Slack.app"
XOXC = re.compile(rb"xoxc-\d+-\d+-\d+-[0-9a-f]+")
XOXD = re.compile(rb"xoxd-[A-Za-z0-9%/+_.=-]+")


def die(msg: str) -> None:
    sys.exit(f"slack-tokens: {msg}")


def read_leveldb(app_dir: str) -> bytes:
    files = glob.glob(os.path.join(app_dir, "Local Storage/leveldb/*.ldb"))
    files += glob.glob(os.path.join(app_dir, "Local Storage/leveldb/*.log"))
    if not files:
        die(f"no Local Storage under {app_dir}; is the Slack desktop app installed and signed in?")
    return b"".join(open(f, "rb").read() for f in files)


def keychain_password(app_dir: str) -> bytes:
    # Direct-download and App Store installs each leave their own "Slack Safe Storage" item.
    account = "Slack App Store Key" if "/Containers/com.tinyspeck.slackmacgap/" in app_dir else "Slack Key"
    out = subprocess.run(
        ["security", "find-generic-password", "-w", "-s", "Slack Safe Storage", "-a", account],
        capture_output=True,
    )
    if out.returncode == 36:
        die("Keychain refused access (interaction not allowed); run in an interactive terminal and allow the prompt")
    if out.returncode == 44:
        die(f"no 'Slack Safe Storage' Keychain item for account {account!r}")
    if out.returncode != 0:
        die(f"could not read the 'Slack Safe Storage' Keychain key ({account!r}): {out.stderr.decode().strip()}")
    return out.stdout.strip()


def find_xoxd(app_dir: str) -> str:
    db = next((p for p in ("Network/Cookies", "Cookies") if os.path.exists(os.path.join(app_dir, p))), None)
    if not db:
        die("no Cookies database in the Slack app directory")
    with tempfile.TemporaryDirectory() as tmp:  # copy so a running Slack can't lock it
        copy = os.path.join(tmp, "Cookies")
        subprocess.run(["cp", os.path.join(app_dir, db), copy], check=True)
        con = sqlite3.connect(f"file:{copy}?mode=ro", uri=True)
        row = con.execute("select encrypted_value from cookies where name='d' and host_key like '%slack.com'").fetchone()
        con.close()
    if not row:
        die("no 'd' cookie for slack.com; sign in to the Slack app, then retry")
    enc = row[0]
    if not enc.startswith(b"v10"):
        die(f"unexpected cookie encryption {enc[:3]!r}; this script handles macOS v10 only")
    key = hashlib.pbkdf2_hmac("sha1", keychain_password(app_dir), b"saltysalt", 1003, dklen=16)
    dec = subprocess.run(
        ["openssl", "enc", "-d", "-aes-128-cbc", "-K", key.hex(), "-iv", (b" " * 16).hex(), "-nopad"],
        input=enc[3:],
        capture_output=True,
    )
    if dec.returncode != 0:
        die(f"openssl could not decrypt the cookie: {dec.stderr.decode().strip()}")
    m = XOXD.search(dec.stdout)  # skips any leading domain-hash prefix and trailing padding
    if not m:
        die("decrypted cookie did not contain an xoxd value; the Keychain key may be wrong")
    return m.group().decode()


def desktop_user_agent(bundle: str) -> str | None:
    """The desktop app's User-Agent, rebuilt from its bundle the way the app builds it."""
    framework = os.path.join(bundle, "Contents/Frameworks/Electron Framework.framework")
    try:
        with open(os.path.join(bundle, "Contents/Info.plist"), "rb") as f:
            slack = plistlib.load(f)["CFBundleShortVersionString"]
        with open(os.path.join(framework, "Resources/Info.plist"), "rb") as f:
            electron = plistlib.load(f)["CFBundleVersion"]
        with open(os.path.join(framework, "Electron Framework"), "rb") as f:
            chrome = re.search(rb"Chrome/(\d+\.\d+\.\d+\.\d+)", f.read())
    except (OSError, KeyError):
        return None
    if not chrome:
        return None
    macos = "_".join((platform.mac_ver()[0].split(".") + ["0", "0"])[:3])
    arch = " AppleSilicon" if platform.machine() == "arm64" else ""
    return (
        f"Mozilla/5.0 (Macintosh; Intel Mac OS X {macos}) AppleWebKit/537.36 (KHTML, like Gecko) "
        f"Slack/{slack} Chrome/{chrome.group(1).decode()} Electron/{electron} Safari/537.36{arch} "
        f"Sonic Slack_SSB/{slack}"
    )


def auth_test(xoxc: str, xoxd: str, user_agent: str | None) -> dict:
    # The cookie goes raw: it is already URL-encoded, and encoding it again gives invalid_auth.
    headers = {"Cookie": f"d={xoxd}"} | ({"User-Agent": user_agent} if user_agent else {})
    req = urllib.request.Request(
        "https://slack.com/api/auth.test",
        data=urllib.parse.urlencode({"token": xoxc}).encode(),
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.load(resp)
    except (urllib.error.URLError, json.JSONDecodeError) as e:
        die(f"auth.test failed: {e}")


def find_xoxc(blob: bytes, xoxd: str, user_agent: str | None, workspace: str) -> tuple[str, dict]:
    """The live xoxc token for the cookie's session in the one workspace whose team/url matches."""
    candidates = dict.fromkeys(m.group().decode() for m in XOXC.finditer(blob))
    if not candidates:
        die("no xoxc token in Local Storage; open the workspace in the app, then retry")
    live: dict[str, tuple[str, dict]] = {}
    for token in candidates:
        info = auth_test(token, xoxd, user_agent)
        if info.get("ok"):
            live.setdefault(info["url"], (token, info))
    if not live:
        die(f"none of {len(candidates)} xoxc tokens is signed in with the current cookie; sign in to the Slack app, then retry")
    hits = [v for u, v in live.items() if workspace.lower() in f"{v[1]['team']} {u}".lower()]
    if len(hits) != 1:
        signed_in = ["%s (%s)" % (info["team"], u) for u, (_, info) in live.items()]
        die(f"workspace {workspace!r} matched {len(hits)} signed-in workspaces; pass --workspace to pick one of {signed_in}")
    return hits[0]


def upsert(env_file: str, values: dict[str, str]) -> None:
    lines = []
    if os.path.exists(env_file):
        lines = [l for l in open(env_file).read().splitlines() if not any(l.startswith(f"{k}=") for k in values)]
    lines += [f"{k}={v}" for k, v in values.items()]
    fd = os.open(env_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")


def main() -> None:
    ap = argparse.ArgumentParser(description="Extract Slack stealth tokens into .env.local")
    ap.add_argument("name", help="source name; sets the SLACK_<NAME>_ env prefix")
    ap.add_argument("--workspace", help="team name/url substring (default: the source name)")
    ap.add_argument("--app-dir", default=APP_DIR, help="Slack app support directory")
    ap.add_argument("--env-file", default=".env.local")
    args = ap.parse_args()
    if sys.platform != "darwin":
        die("only the macOS Slack desktop app is supported")

    name = args.name.upper()
    xoxd = find_xoxd(args.app_dir)
    user_agent = desktop_user_agent(APP_BUNDLE)
    xoxc, info = find_xoxc(read_leveldb(args.app_dir), xoxd, user_agent, args.workspace or args.name)
    values = {f"SLACK_{name}_XOXC_TOKEN": xoxc, f"SLACK_{name}_XOXD_TOKEN": xoxd}
    if user_agent:
        values |= {f"SLACK_{name}_USER_AGENT": user_agent, f"SLACK_{name}_CUSTOM_TLS": "true"}
    else:
        print(f"slack-tokens: no Slack app at {APP_BUNDLE}; set SLACK_{name}_USER_AGENT to the session's browser by hand")
    upsert(args.env_file, values)
    print(f"wrote {', '.join(values)} for {info['team']} ({info['url']}) to {args.env_file}")


if __name__ == "__main__":
    main()

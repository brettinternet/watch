# Values live in gitignored .env.local (or varlock-encrypted/exec() there).
# Undeclared keys, such as per-workspace Slack tokens, default to sensitive so
# `varlock scan` blocks commits that contain them.
# @defaultSensitive=true @defaultRequired=false
# ---

# Pushover application token and user/group key; tell reads them by name.
PUSHOVER_TOKEN=
PUSHOVER_USER=
